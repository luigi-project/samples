{
	"name": "luigi.ui5",
	"version": "1.0.0",
	"description": "UI5 Application: luigi.ui5",
	"author": "JohannesDoberer",
	"license": "Apache-2.0",
	"scripts": {
		"clean": "rimraf dist coverage",
		"build": "ui5 build --clean-dest",
		"build:opt": "ui5 build self-contained --clean-dest --all",
		"serve": "ui5 serve --port 8080",
		"start": "npm run serve -- -o index.html",
		"start-cdn": "npm run serve -- -o index-cdn.html",
		"start:dist": "npm start -- --config ui5-dist.yaml",
		"start:dist-cdn": "npm run start-cdn -- --config ui5-dist.yaml",
		"lint": "eslint webapp",
		"test-runner": "ui5-test-runner --url http://localhost:8080/test/testsuite.qunit.html",
		"test-runner-coverage": "ui5-test-runner --url http://localhost:8080/test/testsuite.qunit.html --coverage -ccb 50 -ccf 50 -ccl 50 -ccs 50",
		"test-ui5": "ui5-test-runner --start serve --url http://localhost:8080/test/testsuite.qunit.html --coverage -ccb 50 -ccf 50 -ccl 50 -ccs 50",
		"test": "npm run lint && npm run test-ui5",
		"wdi5": "wdio run ./webapp/test/e2e/wdio.conf.js"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@ui5/cli": "^4.0.71",
		"@ui5/middleware-code-coverage": "^2.0.3",
		"@wdio/cli": "^9.32.0",
		"@wdio/local-runner": "^9.32.0",
		"@wdio/mocha-framework": "^9.32.0",
		"@wdio/spec-reporter": "^9.32.0",
		"eslint": "^10.13.0",
		"eslint-plugin-jsdoc": "^65.4.2",
		"globals": "^17.13.0",
		"rimraf": "^6.1.3",
		"ui5-middleware-livereload": "^3.4.0",
		"ui5-test-runner": "^5.14.2",
		"wdio-ui5-service": "^3.0.12"
	}
}
